{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-manager.event.control_requested",
  "description": "An operator control was accepted; cancel is the only control. Subject task-manager.event.control_requested.pub (stream ALL_EVENT); headers team=<team_id>, Nats-Msg-Id=task-manager-<publisher_seq>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "task_id",
    "task_name",
    "control",
    "control_id",
    "attempt",
    "claim_seq",
    "executor_id",
    "delivery"
  ],
  "properties": {
    "publisher": {
      "const": "task-manager"
    },
    "publisher_seq": {
      "$ref": "defs.schema.json#/$defs/seq"
    },
    "team_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "occurred_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "kind": {
      "const": "control_requested"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "task_name": {
      "$ref": "defs.schema.json#/$defs/taskName"
    },
    "control": {
      "const": "cancel"
    },
    "control_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "attempt": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "claim_seq": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "defs.schema.json#/$defs/id"
        }
      ]
    },
    "executor_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "defs.schema.json#/$defs/id"
        }
      ]
    },
    "delivery": {
      "enum": ["command", "direct"]
    }
  }
}
