{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-manager.command.<executor> message",
  "description": "Cancel command for the claim holder on TASK_MANAGER_COMMAND, read through commands-<executor_id>. Headers team=<team_id>, Nats-Msg-Id=task-manager-<publisher_seq>, request_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "control",
    "control_id",
    "task_id",
    "attempt",
    "claim_seq",
    "executor_id"
  ],
  "properties": {
    "publisher": {
      "const": "task-manager"
    },
    "publisher_seq": {
      "$ref": "defs.schema.json#/$defs/seq"
    },
    "team_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "occurred_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "control": {
      "const": "cancel"
    },
    "control_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "attempt": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "claim_seq": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "executor_id": {
      "$ref": "defs.schema.json#/$defs/id"
    }
  }
}
