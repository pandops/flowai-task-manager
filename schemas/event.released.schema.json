{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-manager.event.released",
  "description": "task-manager ended a claim without failure: executor_lost (after executor-registry's executor_lost) or claim_missing (rule 26). Subject task-manager.event.released.pub (stream ALL_EVENT); headers team=<team_id>, Nats-Msg-Id=task-manager-<publisher_seq>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "task_id",
    "task_name",
    "attempt",
    "claim_seq",
    "executor_id",
    "reason",
    "republish_at",
    "lost_publisher_seq"
  ],
  "properties": {
    "publisher": {
      "const": "task-manager"
    },
    "publisher_seq": {
      "$ref": "defs.schema.json#/$defs/seq"
    },
    "team_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "occurred_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "kind": {
      "const": "released"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "task_name": {
      "$ref": "defs.schema.json#/$defs/taskName"
    },
    "attempt": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "claim_seq": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "executor_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "reason": {
      "enum": ["executor_lost", "claim_missing"]
    },
    "republish_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "defs.schema.json#/$defs/timestamp"
        }
      ]
    },
    "lost_publisher_seq": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "defs.schema.json#/$defs/seq"
        }
      ]
    }
  }
}
