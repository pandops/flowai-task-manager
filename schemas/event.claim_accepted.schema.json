{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-manager.event.claim_accepted",
  "description": "task-manager accepted the first created event of the claim (design rule 28); the only claim-holder record. Subject task-manager.event.claim_accepted.pub (stream ALL_EVENT); headers team=<team_id>, Nats-Msg-Id=task-manager-<publisher_seq>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "task_id",
    "task_name",
    "attempt",
    "claim_seq",
    "executor_id",
    "created_publisher_seq"
  ],
  "properties": {
    "publisher": {
      "const": "task-manager"
    },
    "publisher_seq": {
      "$ref": "defs.schema.json#/$defs/seq"
    },
    "team_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "occurred_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "kind": {
      "const": "claim_accepted"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "task_name": {
      "$ref": "defs.schema.json#/$defs/taskName"
    },
    "attempt": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "claim_seq": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "executor_id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "created_publisher_seq": {
      "$ref": "defs.schema.json#/$defs/seq"
    }
  }
}
